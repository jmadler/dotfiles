[user]
	name = Jordan M. Adler
	email = jordan.m.adler@gmail.com
[alias]
	sync = !git fetch origin && git rebase origin/main
	delete-merged = !git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == "[gone]" { print $1 }' | xargs -r git branch -D
[commit]
	verbose = true
[core]
	excludesfile = ~/.gitignore
[merge]
	conflictstyle = zdiff3
[push]
	autoSetupRemote = true
# Auth is delegated to the gh credential helper. Never store a token in this file.
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
